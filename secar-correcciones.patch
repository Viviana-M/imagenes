@@ -0,0 +1,42 @@
+<?php
+
+use Illuminate\Database\Migrations\Migration;
+use Illuminate\Database\Schema\Blueprint;
+use Illuminate\Support\Facades\Schema;
+
+/**
+ * Índices de rendimiento para las tablas más consultadas.
+ *
+ * `registro_financieros` es la tabla central del sistema: casi todas las
+ * pantallas agregan sobre ella con filtros por (cuenta_mayor, anio, mes) y
+ * agrupaciones por codigo_proyecto. Sin índices, cada consulta es un escaneo
+ * completo de tabla, que se degrada a medida que crece (~20.000+ filas/mes).
+ */
+return new class extends Migration
+{
+    public function up(): void
+    {
+        Schema::table('registro_financieros', function (Blueprint $table) {
+            $table->index(['cuenta_mayor', 'anio', 'mes'], 'idx_regfin_cuentamayor_periodo');
+            $table->index(['codigo_proyecto', 'cuenta_mayor'], 'idx_regfin_proyecto_cuentamayor');
+            $table->index('cuenta_contable', 'idx_regfin_cuentacontable');
+        });
+
+        Schema::table('forecast_operativo', function (Blueprint $table) {
+            $table->index(['codigo_proyecto', 'anio', 'mes'], 'idx_forecast_proyecto_periodo');
+        });
+    }
+
+    public function down(): void
+    {
+        Schema::table('registro_financieros', function (Blueprint $table) {
+            $table->dropIndex('idx_regfin_cuentamayor_periodo');
+            $table->dropIndex('idx_regfin_proyecto_cuentamayor');
+            $table->dropIndex('idx_regfin_cuentacontable');
+        });
+
+        Schema::table('forecast_operativo', function (Blueprint $table) {
+            $table->dropIndex('idx_forecast_proyecto_periodo');
+        });
+    }
+};
